# === LLM Provider ===
LLM_PROVIDER=openrouter          # openrouter | claude-cli | codex-cli
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# === TTS Provider ===
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-GuyNeural        # Run: shorts-factory voice --list
TTS_RATE=+0%
TTS_PITCH=+0Hz

# === Background Music ===
BGM_PATH=                        # Optional: local path to .mp3 file

# === Clips Provider ===
PEXELS_API_KEY=                  # Get free key at pexels.com/api

# === YouTube Upload ===
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# === Web UI ===
WEB_BIND=127.0.0.1                # Change to 0.0.0.0 for LAN access
WEB_PORT=8765
SECRET_KEY=                       # Leave empty to auto-generate at startup

# === Storage ===
SHORTS_DATA_DIR=                  # Override default data dir (defaults to ./data)
